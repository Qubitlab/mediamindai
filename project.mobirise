              "opacity": "@OpacityBgImg"
            },
            ".img-bg-overlay": {
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "100%",
              "height": "100%",
              "background-image": "radial-gradient(circle farthest-corner at 0 100%, rgba(24, 24, 23, 0.9) 38%, rgba(24, 24, 23, 0.5))"
            },
            ".text-wrap": {
              "position": "relative",
              "z-index": "5",
              "width": "100%"
            },
            ".mbr-section-title": {
              "color": "#FACB1D",
