          "_name": "aheader3",
          "_sourceTheme": "mediam5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header3 mediam5\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"10\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"10\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Image Bg\" name=\"showImgBg\" checked>\n        <input type=\"color\" title=\"Image Bg Color\" name=\"iconBg\" value=\"#f6f6ef\" condition=\"showImgBg\">\n        <input type=\"range\" inline name=\"iconOpacity\" title=\"Image Bg Opacity\" min=\"0\" max=\"1\" value=\"1\" step=\"0.01\" condition=\"showImgBg\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background2.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#FACB1D\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#FACB1D\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"img-bg\" mbr-if=\"showImgBg\"></div>\n    <div class=\"container\">\n        <div class=\"row justify-content-center align-items-center\">\n            <div class=\"col-12 col-text\">\n                <div class=\"text-wrapper\">\n                    <h1 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\">\n                        <b>\n                            ALL VIDEOS\n                        </b>\n                    </h1>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n                        Unlocking the Power of Social Media: Seize the Financial Opportunity to Build Your Brand and Drive Revenue\n                    </p>\n                    <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                        <a class=\"btn btn-black\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            Read More\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "tjiNZs3BUg",
          "_anchor": "aheader3-g",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "background-attachment": "fixed",
              "background-repeat": "no-repeat",
              "background-size": "cover",
              "background-position": "center center"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".mbr-section-head": {
              "margin-bottom": "2rem",
              "width": "100%"
            },
            ".mbr-section-title": {
              "color": "#181817"
            },
            ".mbr-section-subtitle": {
              "color": "#181817",
              "margin-top": "1rem"
            },
            ".card-row": {
              "align-items": "stretch"
            },
            ".item": {
              "margin-bottom": "2rem",
              "@media (min-width: 1400px)": {
                "width": "(100% / @columnCount) !important"
              },
              "@media (min-width: 768px)": {
                "& when (@columnCount < 3)": {
                  "width": "(100% / @columnCount) !important"
                }
              }
            },
            ".item-wrapper": {
              "display": "flex",
              "align-items": "flex-end",
              "position": "relative",
              "height": "100%",
              "width": "100%",
              "border-radius": "1.5rem",
              "overflow": "hidden",
              "padding-top": "20px",
              "min-height": "(@imgHeight * 235px)",
              "@media (max-width: 991px)": {
                "min-height": "(@imgHeight * 180px)"
              },
              "& when (@hoverEffect)": {
                "&:hover": {
                  ".card-box": {
                    "opacity": "0"
                  },
                  ".bg-overlay": {
                    "display": "flex",
                    "&:hover": {
                      ".mbr-section-btn": {
                        "transform": "translateY(0)",
                        "opacity": "1"
                      }
                    }
                  },
                  ".bg-overlay-color": {
                    "opacity": "0.8"
                  }
                }
              }
            },
            ".item-img": {
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "100%",
              "height": "100%",
              "z-index": "2",
              "img": {
                "width": "100%",
                "height": "100%",
                "object-fit": "cover"
              }
            },
            ".card-box": {
              "position": "relative",
              "z-index": "3",
              "padding": "8rem 1.5rem 1.5rem",
              "background-image": "linear-gradient(180deg, rgba(24, 24, 23, 0), rgba(24, 24, 23, 0.9) 65%)",
              "transition": "0.4s all",
              "opacity": "1"
            },
            ".card-title": {
              "color": "#f6f6ef",
              "margin-bottom": "0.6rem"
            },
            ".card-subtitle": {
              "color": "#f6f6ef",
              "margin-bottom": "1rem",
              "margin-top": "0 !important"
            },
            ".card-text": {
              "color": "#f6f6ef",
              "margin-bottom": "0"
            },
            ".card-text-container": {
              "display": "flex",
              "align-items": "center",
              "padding-top": "0.5rem"
            },
            ".iconfont-wrapper": {
              "margin-right": "18px",
              ".mbr-iconfont": {
                "display": "block",
                "font-size": "20px",
                "color": "@iconColor",
                "width": "fit-content"
              }
            },
            ".bg-overlay": {
              "display": "none",
              "flex-direction": "column",
              "align-items": "stretch",
              "justify-content": "center",
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "100%",
              "height": "100%",
              "z-index": "4"
            },
            ".bg-overlay-color": {
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "100%",
              "height": "100%",
              "background-color": "#181817",
              "opacity": "0",
              "z-index": "5",
              "transition": "0.4s all"
            },
            ".mbr-section-btn": {
              "position": "relative",
              "z-index": "6",
              "transform": "translateY(2rem)",
              "transition": "0.4s all",
              "opacity": "0",
              "padding": "0 1rem",
              ".btn": {
                "box-shadow": "none !important"
              },
              "@media (max-width: 575px)": {
                "width": "auto",
                "& .btn": {
                  "width": "auto",
                  "min-width": "auto !important"
                }
              }
            }
          },
          "_name": "agallery1",
          "_sourceTheme": "mediam5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"gallery1 mediam5\" group=\"Gallery &amp; Slider\" data-bg-video=\"{{bg.type == 'video' &amp;&amp; bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline=\"\" title=\"Image Height\" name=\"imgHeight\" min=\"1\" max=\"4\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline=\"\" title=\"Column Count\" name=\"columnCount\" min=\"2\" max=\"5\" step=\"1\" value=\"5\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\">Left</option>\n            <option value=\"justify-content-center\" selected=\"\">Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showMainTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showMainSubtitle\">\n        <header>Card</header>\n        <input type=\"checkbox\" title=\"Hover Effect\" name=\"hoverEffect\" checked=\"\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" checked=\"\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked=\"\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcon\" checked=\"\">\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#f6f6ef\" selected=\"\" condition=\"showIcon\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background2.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#FACB1D\" selected=\"\">\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#FACB1D\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\" mbr-if=\"showMainTitle || showMainSubtitle\">\n                <div class=\"mbr-section-head\">\n                    <h3 class=\"mbr-section-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showMainTitle\" data-app-selector=\".mbr-section-title\">\n                        <b>\n                            SEM VIVERRA ALIQUET\n                        </b>\n                    </h3>\n                    <h5 class=\"mbr-section-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showMainSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                        Mauris pellentesque pulvinar pellentesque habitant morbi tristique senectus et.\n                    </h5>\n                </div>\n            </div>\n        </div>\n        <div class=\"row card-row {{contentAlign}}\">\n            <div class=\"item features-image col-12 col-sm-6 col-md-4 col-xl-4 active\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/babe-1280x720.jpg\" alt=\"Mobirise Website Builder\" data-slide-to=\"0\" data-bs-slide-to=\"0\">\n                    </div>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showSubtitle || showIcon || showText\">\n                        <h5 class=\"card-title align-left mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                            Platea dictumst quisque\n                        </h5>\n                        <h6 class=\"card-subtitle align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">\n                            Nec feugiat nisl\n                        </h6>\n                        <div class=\"card-text-container\">\n                            <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                <span mbr-icon=\"\" class=\"mbr-iconfont mobi-mbri-play mobi-mbri\"></span>\n                            </div>\n                            <p class=\"card-text align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">\n                                3 BILLION VIEWS\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"bg-overlay\">\n                        <div class=\"bg-overlay-color\"></div>\n                        <div class=\"mbr-section-btn align-center\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons=\"\" mbr-theme-style=\"display-7\"><a href=\"https://youtu.be/kffacxfA7G4\" class=\"btn btn-white-outline\" target=\"_blank\" data-app-placeholder=\"Type Text\">\n                                WATCH VIDEO\n                            </a></div>\n                    </div>\n                </div>\n            </div><div class=\"item features-image col-12 col-sm-6 col-md-4 col-xl-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/screenshot-2023-05-16-at-11-01-35-coca-cola-822x1461.png\" alt=\"Mobirise Website Builder\" data-slide-to=\"1\" data-bs-slide-to=\"1\">\n                    </div>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showSubtitle || showIcon || showText\">\n                        <h5 class=\"card-title align-left mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                            Sapien pellentesque habitant\n                        </h5>\n                        <h6 class=\"card-subtitle align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">\n                            Auctor elit sed\n                        </h6>\n                        <div class=\"card-text-container\">\n                            <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                <span mbr-icon=\"\" class=\"mbr-iconfont mobi-mbri-play mobi-mbri\"></span>\n                            </div>\n                            <p class=\"card-text align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">\n                              7M VIEWS\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"bg-overlay\">\n                        <div class=\"bg-overlay-color\"></div>\n                        <div class=\"mbr-section-btn align-center\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons=\"\" mbr-theme-style=\"display-7\"><a href=\"https://youtube.com/shorts/gmJGqWp7eWQ?feature=share\" class=\"btn btn-white-outline\" target=\"_blank\" data-app-placeholder=\"Type Text\">\n                                WATCH VIDEO\n                            </a></div>\n                    </div>\n                </div>\n            </div><div class=\"item features-image col-12 col-sm-6 col-md-4 col-xl-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/short2-1280x720.jpg\" alt=\"Mobirise Website Builder\" data-slide-to=\"2\" data-bs-slide-to=\"2\">\n                    </div>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showSubtitle || showIcon || showText\">\n                        <h5 class=\"card-title align-left mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                            Sapien pellentesque habitant\n                        </h5>\n                        <h6 class=\"card-subtitle align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">\n                            Auctor elit sed\n                        </h6>\n                        <div class=\"card-text-container\">\n                            <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                <span mbr-icon=\"\" class=\"mbr-iconfont mobi-mbri-play mobi-mbri\"></span>\n                            </div>\n                            <p class=\"card-text align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"show