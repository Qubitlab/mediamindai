       <p class=\"card-text align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">\n                            634M VIEWS\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"bg-overlay\">\n                        <div class=\"bg-overlay-color\"></div>\n                        <div class=\"mbr-section-btn align-center\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons=\"\" mbr-theme-style=\"display-7\"><a href=\"https://youtu.be/YlvcFJOE-OE\" class=\"btn btn-white-outline\" target=\"_blank\" data-app-placeholder=\"Type Text\">\n                                WATCH VIDEO\n                            </a></div>\n                    </div>\n                </div>\n            </div>\n\n            \n            <div class=\"item features-image col-12 col-sm-6 col-md-4 col-xl-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/short3333-1280x720.jpg\" alt=\"Mobirise Website Builder\" data-slide-to=\"6\" data-bs-slide-to=\"6\">\n                    </div>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showSubtitle || showIcon || showText\">\n                        <h5 class=\"card-title align-left mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                            Fames ac turpis egestas\n                        </h5>\n                        <h6 class=\"card-subtitle align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">\n                            Lacus vel facilisis\n                        </h6>\n                        <div class=\"card-text-container\">\n                            <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                <span mbr-icon=\"\" class=\"mbr-iconfont mobi-mbri-play mobi-mbri\"></span>\n                            </div>\n                            <p class=\"card-text align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">\n                                8.3M VIEWS\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"bg-overlay\">\n                        <div class=\"bg-overlay-color\"></div>\n                        <div class=\"mbr-section-btn align-center\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons=\"\" mbr-theme-style=\"display-7\"><a href=\"https://youtu.be/f9NbYQMjTbg\" class=\"btn btn-white-outline\" target=\"_blank\" data-app-placeholder=\"Type Text\">\n                                WATCH VIDEO\n                            </a></div>\n                    </div>\n                </div>\n            </div>\n            \n            \n        </div>\n    </div>\n</section>",
          "_cid": "tjiO0o6piy",
