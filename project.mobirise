        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".grid-container": {
              "display": "grid",
              "grid-auto-flow": "column",
              "grid-auto-columns": "1fr",
              "grid-column-gap": "2rem",
              "grid-row-gap": "2rem",
              "-ms-grid-columns": "3fr 6fr",
              "grid-template-columns": "3fr 6fr",
              "-ms-grid-rows": "auto",
              "grid-template-rows": "auto",
              "@media (max-width: 991px)": {
                "grid-auto-flow": "row",
                "-ms-grid-columns": "1fr",
                "grid-template-columns": "1fr"
              }
            },
            ".mbr-section-title": {
              "color": "#FACB1D"
            },
            ".mbr-section-subtitle": {
              "color": "#f6f6ef",
              "margin-top": "1rem"
            },
            ".list": {
              "width": "100%",
              "list-style": "none",
              "& when (@showMarker)": {
                "padding-left": "40px"
              },
              "margin-bottom": "0",
              "color": "#f6f6ef",
              "transition": "0.3s all",
              "li": {
                "position": "relative",
                "width": "100%",
                "color": "inherit !important",
                "transition": "0.3s all",
                "&:not(:first-child)": {
                  "margin-top": "1rem"
                },
                "& when (@showMarker)": {
                  "&:before": {
                    "content": "\"\"",
                    "position": "absolute",
                    "top": "15px",
                    "left": "-20px",
                    "width": "9px",
                    "height": "9px",
                    "border-radius": "50%",
                    "background-color": "currentColor"
                  }
                }
              },
              "a": {
                "color": "inherit !important",
                "line-height": "inherit !important",
                "font-weight": "inherit !important",
                "transition": "0.3s all",
                "&:hover": {
                  "color": "@primaryColor !important",
                  "line-height": "inherit !important"
                }
              }
            }
          },
          "_name": "alist1",
          "_sourceTheme": "mediam5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"list1 mediam5\" group=\"List\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" step=\"1\" value=\"12\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\" selected>Left</option>\n            <option value=\"justify-content-center\">Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Marker\" name=\"showMarker\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#181817\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#181817\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row {{contentAlign}}\">\n            <div class=\"col-12 col-lg-{{textWidth}}\">\n                <div class=\"grid-container\">\n                    <div class=\"title-box\">\n                        <h3 class=\"mbr-section-title mbr-fonts-style mb-0\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\"><b>THE BENEFITS OF EMBRACING SOCIAL VIDEO</b></h3>\n                        <h4 class=\"mbr-section-subtitle mbr-fonts-style mb-0\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-4\"><b>Enhanced Engagement</b>: Social video captures attention and drives higher engagement rates, with users spending more time watching and interacting with video content than other media forms.<br><br><br></h4>\n                    </div>\n                    <div class=\"list-box\">\n                        <ul class=\"list second-list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".second-list\" data-multiline=\"true\" data-app-edit=\"full\" mbr-article>\n                            <li class=\"mbr-text item-wrap\" data-app-selector=\".second-list\"><span style=\"color: inherit; font-size: 1.5rem;\">Improved Message Retention: Visual storytelling through video creates a memorable and lasting impact, making it easier for viewers to retain and recall your brand message.</span></li><li class=\"mbr-text item-wrap\" data-app-selector=\".second-list\"><span style=\"color: inherit; font-size: 1.5rem;\"><b>Emotional Connection</b>: Video allows you to evoke emotions and connect with your audience on a deeper level, fostering stronger brand loyalty and affinity.</span><br></li><li class=\"mbr-text item-wrap\" data-app-selector=\".second-list\"><b>Higher Conversion Rates</b>: Incorporating video into your marketing strategy can increase conversions and sales, as videos have been shown to drive purchase intent and decision-making.\n</li><li class=\"mbr-text item-wrap\" data-app-selector=\".second-list\"><b>Amplified Social Sharing</b>: Engaging and shareable video content has the potential to go viral, exponentially expanding your brand's reach as users share your videos across social media platforms.</li><li class=\"mbr-text item-wrap\" data-app-selector=\".second-list\"><b>Improved SEO and Discoverability</b>: Video content can boost your search engine rankings and enhance discoverability, as search engines increasingly prioritize video results and users actively seek out video content.\n</li><li class=\"mbr-text item-wrap\" data-app-selector=\".second-list\"><b>Stronger Brand Personality</b>: Video lets you showcase your brand's personality, values, and unique selling propositions, helping you stand out from competitors and establish a distinct brand identity.</li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "tjiLgQmbVp",
