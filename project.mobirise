              "height": "100%",
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)",
              "border-radius": "1.5rem",
              "overflow": "hidden"
            },
            ".img-bg": {
              "position": "absolute",
