            },
            ".mbr-text": {
              "color": "#f6f6ef",
              "opacity": "0.8",
              "margin-bottom": "1rem"
            },
            ".mbr-section-btn": {
              "margin-top": "1rem"
            },
            ".mbr-text, .mbr-section-btn": {
              "text-align": "left"
            }
          },
          "_name": "afeatures10",
          "_sourceTheme": "mediam5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features10 mediam5\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"8\" step=\"1\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\" selected>Left</option>\n            <option value=\"justify-content-center\">Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"image\" title=\"Content Bg Image\" name=\"contentBgImg\" value=\"@PROJECT_PATH@/assets/images/features12.jpg\">\n        <input type=\"range\" inline title=\"Opacity Bg Image\" name=\"OpacityBgImg\" min=\"0\" max=\"1\" step=\"0.01\" value=\"1\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n            <input type=\"color\" title=\"Color\" value=\"#181817\" selected>\n        </fieldset>\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n    <div class=\"container\">\n        <div class=\"img-bg-container\">\n            <div class=\"img-bg\"></div>\n            <div class=\"img-bg-overlay\"></div>\n            <div class=\"row {{contentAlign}}\">\n                <div class=\"col-12 col-lg-{{textWidth}} col-text\">\n                    <div class=\"text-wrap\">\n                        <h1 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title\" mbr-if=\"showTitle\"><b>KEY FACTORS TO CONSIDER FOR SOCIAL VIDEO</b></h1>\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\"><b>Audience Relevance</b>: Understanding your target audience and creating social video content that resonates with them is critical to success. Tailor your videos to align with their interests, preferences, and demographics to maximize engagement and effectiveness.\n<br>\n<br><b>Storytelling and Narrative</b>: Crafting compelling and authentic stories through your social videos is crucial. Develop a straightforward narrative that connects emotionally with viewers, evokes curiosity, and leaves a lasting impression. Compelling storytelling enhances engagement and fosters a deeper connection with your brand.<br>\n<br><b>Stronger Brand Personality</b>: Video lets you showcase your brand's personality, values, and unique selling propositions, helping you stand out from competitors and establish a distinct brand identity.<br>\n<br><b>Accessible and Mobile</b>-Friendly: With most social media users accessing platforms from mobile devices, social video ensures that your content is easily consumable, reaching users wherever they are.<br>\n                        </p>\n                        <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\"><a class=\"btn btn-white-outline\" href=\"index.html\" data-app-placeholder=\"Type Text\">\n                                <span class=\"mobi-mbri mobi-mbri-play mbr-iconfont mbr-iconfont-btn\"></span>\n                                SEE OUR PREVIOUS SUCCESSFUL WORKS\n                            </a></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "tjiMevx4RK",
          "_anchor": "afeatures10-6",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
