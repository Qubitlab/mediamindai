                  "&:-moz-placeholder": {
                    "color": "#bbbbbb"
                  },
                  "&:-ms-input-placeholder": {
                    "color": "#bbbbbb"
                  }
                }
              },
              ".row": {
                "margin-left": "-5px !important",
                "margin-right": "-5px !important"
              },
              ".row [class*=col]": {
                "padding-left": "5px !important",
                "padding-right": "5px !important"
              },
              "label": {
                "width": "100%",
                "color": "#f6f6ef",
                "margin-bottom": "0.4rem"
              },
              ".form-check-input": {
                "border-color": "#bbbbbb !important",
                "outline": "none !important",
                "box-shadow": "none !important",
                "background-color": "transparent !important",
                "&:focus, &:hover": {
                  "background-color": "transparent !important",
                  "border-color": "#181817 !important"
                }
              },
              ".form-check-input:checked": {
                "border-color": "#181817 !important",
                "background-color": "#FACB1D !important"
              }
            }
          },
          "_name": "aform1",
          "_sourceTheme": "mediam5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"form1 mediam5\" group=\"Forms\" plugins=\"formstyler, datepicker\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline=\"\" title=\"Width\" name=\"formWidth\" min=\"6\" max=\"12\" step=\"1\" value=\"6\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\">Left</option>\n            <option value=\"justify-content-center\" selected=\"\">Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#2c2c2c\" selected=\"\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#2c2c2c\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"hidden\" name=\"usedRecaptcha\" value=\"false\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"(overlay &amp;&amp; bg.type=='image')\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row {{contentAlign}}\">\n            <div class=\"col-12 col-lg-{{formWidth}}\">\n                <div class=\"mbr-section-head\" mbr-if=\"showTitle || showSubtitle\">\n                    <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n                        <b>GET IN <a href=\"#\" class=\"text-primary\">TOUCH</a></b>\n                    </h3>\n                    <h4 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                        Sed risus pretium quam vulputate dignissim\n                    </h4>\n                </div>\n\n                <div class=\"form-wrap\">\n                    <div mbr-form=\"\" class=\"mbr-form\">\n<!--Formbuilder Form-->\n<form action=\"\" name=\"Media Minds A!\" method=\"POST\" class=\"mbr-form form-with-styler mx-auto\">\n<div class=\"row\">\n<div hidden=\"hidden\" data-form-alert=\"\" class=\"alert alert-success col-12\"> Thanks for filling out the form!</div>\n<div hidden=\"hidden\" data-form-alert-danger=\"\" class=\"alert alert-danger col-12\"> Oops...! some problem! </div>\n</div>\n<div class=\"dragArea row\">\n<div class=\"col-12 form-group mb-3 mb-3\" data-for=\"name\">\n<label mbr-text=\"\" mbr-theme-style=\"display-7\" for=\"name\" class=\"form-control-label mbr-fonts-style\"> Name </label>\n<input type=\"text\" name=\"name\" placeholder=\"Introduce your name\" data-form-field=\"name\" mbr-theme-style=\"display-7\" class=\"form-control display-7\" value=\"\">\n</div>\n<div class=\"col-12 form-group mb-3 mb-3\" data-for=\"email\">\n<label mbr-text=\"\" mbr-theme-style=\"display-7\" for=\"email\" class=\"form-control-label mbr-fonts-style\"> Email </label>\n<input type=\"email\" name=\"email\" placeholder=\"Introduce your email\" data-form-field=\"email\" mbr-theme-style=\"display-7\" class=\"form-control display-7\" value=\"\">\n</div>\n<div data-for=\"subject\" class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\">\n<label mbr-text=\"\" mbr-theme-style=\"display-7\" for=\"subject\" class=\"form-control-label mbr-fonts-style\"> Subject </label>\n<input type=\"text\" name=\"subject\" placeholder=\"Introduce a subject\" data-form-field=\"subject\" mbr-theme-style=\"display-7\" class=\"form-control display-7\" value=\"\">\n</div>\n<div data-for=\"message\" class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3 mb-3\">\n<label mbr-text=\"\" mbr-theme-style=\"display-7\" for=\"message\" class=\"form-control-label mbr-fonts-style\"> Message </label>\n<textarea name=\"message\" placeholder=\"\" data-form-field=\"message\" mbr-theme-style=\"display-7\" class=\"form-control display-7\" value=\" \"> </textarea>\n</div>\n<div class=\"col-auto mbr-section-btn align-center\" mbr-buttons=\"true\" mbr-theme-style=\"display-7\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\">\n<a data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" type=\"submit\" class=\"w-100 btn btn-primary\">Send</a>\n</div>\n</div>\n</form><!--Formbuilder Form-->\n</div>\n                </div>\n\n\n<!--                <div class=\"col-auto mbr-section-btn align-center\" mbr-buttons=\"true\"-->\n<!--                     mbr-theme-style=\"display-7\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\">-->\n<!--                    <a data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" type=\"submit\"-->\n<!--                       class=\"btn btn-primary\">Send</a>-->\n<!--                </div>-->\n\n\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "tjiMsIxy48",
          "_anchor": "aform1-7",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".row": {
              "& when (@reverseContent)": {
                "flex-direction": "row-reverse"
              }
            },
            ".col-text": {
              "@media (max-width: 991px)": {
                "margin-bottom": "2rem"
              }
            },
            ".text-wrap": {
              "position": "sticky",
              "top": "5rem",
              "@media (max-width: 991px)": {
                "position": "static",
                "max-width": "440px",
                "margin-right": "auto"
              },
              "@media (max-width: 767px)": {
                "max-width": "100%",
                "width": "100%"
              }
            },
            ".mbr-section-title": {
              "color": "#181817"
            },
            ".text-grid-container": {
              "display": "grid",
              "grid-auto-columns": "1fr",
              "grid-column-gap": "2rem",
              "-ms-grid-columns": "4fr 1fr",
              "grid-template-columns": "4fr 1fr",
              "-ms-grid-rows": "auto auto",
              "grid-template-rows": "auto auto",
              "margin-top": "2rem"
            },
            ".mbr-text": {
              "color": "#181817",
              "opacity": "0.8",
              "margin-bottom": "1rem",
              "grid-column-start": "1",
              "grid-column-end": "2",
              "@media (max-width: 767px)": {
                "grid-column-end": "3"
              }
            },
            ".card-container": {
              "width": "100%",
              "margin-top": "15rem",
              "@media (max-width: 575px)": {
                "margin-top": "0"
              }
            },
            ".card": {
              "position": "sticky",
              "top": "0",
              "width": "100%",
              "padding": "30px 0",
              "@media (max-width: 991px)": {
                "padding": "24px 0"
              },
              "@media (max-width: 575px)": {}
            },
            ".card-wrap": {
              "display": "flex",
              "align-items": "flex-end",
              "position": "relative",
              "z-index": "4",
              "width": "100%",
              "padding": "40px",
              "border-radius": "2.5rem",
              "overflow": "hidden",
              "min-height": "745px",
              "@media (max-width: 1599px)": {
                "min-height": "615px"
              },
              "@media (max-width: 1399px)": {
                "min-height": "525px"
              },
              "@media (max-width: 1199px)": {
                "min-height": "435px"
              },
              "@media (max-width: 991px)": {
                "min-height": "560px"
              },
              "@media (max-width: 767px)": {
                "padding": "24px"
              }
            },
            ".card-img-box": {
              "position": "absolute",
              "top": "0",
              "left": "0",
              "z-index": "3",
              "width": "100%",
              "height": "100%",
              "img": {
                "width": "100%",
                "height": "100%",
                "object-fit": "cover"
              }
            },
            ".card-bg-frame": {
              "position": "absolute",
              "left": "-33%",
              "bottom": "-40%",
              "width": "(@iconSize * 1%)",
              "aspect-ratio": "1",
              "z-index": "4",
              "border-radius": "50%",
              "background": "rgba(red(@cardBg), green(@cardBg), blue(@cardBg), @iconOpacity)",
              "@media (max-width: 991px)": {
                "left": "-40%",
                "bottom": "-30%"
              },
              "@media (max-width: 767px)": {
                "left": "-28%",
                "bottom": "-20%",
                "width": "100vw",
                "height": "100vw"
              },
              "@media (max-width: 575px)": {
                "left": "-46%",
                "bottom": "-22%"
              }
            },
            ".card-text-box": {
              "position": "relative",
              "z-index": "5",
              "width": "40%",
              "@media (max-width: 767px)": {
                "width": "70%"
              },
              "@media (max-width: 575px)": {
                "width": "100%"
              }
            },
            ".card-title": {
              "color": "#f6f6ef",
              "margin-bottom": "1rem"
            },
            ".card-text": {
              "color": "#f6f6ef",
              "opacity": "0.8",
              "margin-bottom": "1rem"
            },
            ".card-number": {
              "color": "#f6f6ef",
              "margin-bottom": "0"
            },
            ".card-text-small": {
              "color": "#f6f6ef",
              "margin-bottom": "0"
            },
            ".mbr-section-btn": {
              "margin-top": "10px"
            }
          },
          "_name": "afeatures3",
          "_sourceTheme": "mediam5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features3 mediam5\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Card</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showCardText\" checked>\n        <input type=\"checkbox\" title=\"Number\" name=\"showCardNumber\" checked>\n        <input type=\"checkbox\" title=\"Text Small\" name=\"showCardTextSmall\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Image Bg\" name=\"showCardImg\" checked>\n        <input type=\"color\" title=\"Image Bg Color\" name=\"cardBg\" value=\"#181817\" condition=\"showCardImg\">\n        <input type=\"range\" inline name=\"iconSize\" title=\"Image Bg Size\" min=\"1\" max=\"170\" value=\"80\" step=\"1\" condition=\"showCardImg\">\n        <input type=\"range\" inline name=\"iconOpacity\" title=\"Image Bg Opacity\" min=\"0\" max=\"1\" value=\"1\" step=\"0.01\" condition=\"showCardImg\">\n        <input type=\"range\" inline name=\"cardCount\" title=\"Card Count\" min=\"1\" max=\"5\" value=\"5\" step=\"1\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background2.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#FACB1D\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#FACB1D\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row align-items-stretch\">\n            <div class=\"col-12 col-lg-4 col-text\" mbr-if=\"showTitle || showText\">\n                <div class=\"text-wrap w-100\">\n                    <h1 class=\"mbr-section-title mbr-fonts-style mb-0\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                        <b>VIDEOS MADE TO&nbsp;BE POPULAR</b>\n                    </h1>\n                    <div class=\"text-grid-container w-100\" mbr-if=\"showText\">\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">\n                            Videos made to be popular are strategically designed with captivating elements, creative concepts, and viral potential to attract a broad audience and generate widespread attention and engagement.\n                        </p>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-12 col-lg-8 col-card flex-grow-1\">\n                <div class=\"card-container\">\n                    <div class=\"card\">\n                        <div class=\"card-wrap\">\n                            <div class=\"card-img-box\">\n                                <img src=\"@PROJECT_PATH@/assets/images/maxresdefault-1280x720.jpg\" alt>\n                            </div>\n                            <div class=\"card-bg-frame\" mbr-if=\"showCardImg\"></div>\n                            <div class=\"card-text-box\">\n                                <h3 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\">\n                                    <b>Tiger Woods </b><br><b>Rory Mclllroy</b></h3>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text, .mbr-section-btn\" mbr-if=\"showCardText\">\n                                    Tiger Woods, Rory McIlroy &amp; Collin Morikawa Experience Stealth 2 Driver | TaylorMade Golf\n                                </p>\n                                <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-number\" mbr-if=\"showCardNumber\">\n                                    <b>6.5 M</b>\n                                </p>\n                                <p class=\"card-text-small mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text-small\" mbr-if=\"showCardTextSmall\">\n                                    VIEWS\n                                </p>\n                                <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white-outline\" href=\"https://youtu.be/3W03naKIXS4\" data-app-placeholder=\"Type Text\" target=\"_blank\">\n                                        <span class=\"mobi-mbri mobi-mbri-play mbr-iconfont mbr-iconfont-btn\"></span>\n                                        WATCH\n                                    </a></div>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"card\" mbr-if=\"cardCount > 1\">\n                        <div class=\"card-wrap\">\n                            <div class=\"card-img-box\">\n                                <img src=\"@PROJECT_PATH@/assets/images/new8-1280x720.jpg\" alt=\"action\">\n                            </div>\n                            <div class=\"card-bg-frame\" mbr-if=\"showCardImg\"></div>\n                            <div class=\"card-text-box\">\n                                <h3 class=\"card-title mbr-fonts-style mb-0\" data-app-selector=\".card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\"><b>PEOPLE ARE AWESOME 2017&nbsp; EXTREME SPORTS EDITION</b></h3>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text, .mbr-section-btn\" mbr-if=\"showCardText\">\n                                    Compilation of the best extreme sports in the world\n                                </p>\n                                <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-number\" mbr-if=\"showCardNumber\"><b>11 M</b>\n                                </p>\n                                <p class=\"card-text-small mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text-small\" mbr-if=\"showCardTextSmall\">\n                                    VIEWS\n                                </p>\n                                <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white-outline\" href=\"https://youtu.be/AQkbbtDoPq0\" data-app-placeholder=\"Type Text\" target=\"_blank\">\n                                        <span class=\"mobi-mbri mobi-mbri-play mbr-iconfont mbr-iconfont-btn\"></span>\n                                        WATCH\n                                    </a></div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardCount > 2\">\n                        <div class=\"card-wrap\">\n                            <div class=\"card-img-box\">\n                                <img src=\"@PROJECT_PATH@/assets/images/utube3-1280x720.jpg\" alt=\"wallen\">\n                            </div>\n                            <div class=\"card-bg-frame\" mbr-if=\"showCardImg\"></div>\n                            <div class=\"card-text-box\">\n                                <h3 class=\"card-title mbr-fonts-style mb-0\" data-app-selector=\".card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\"><b>Morgan Wallen - One Thing At A Time&nbsp;</b><b><br></b></h3>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text, .mbr-section-btn\" mbr-if=\"showCardText\">\n                                    Music video by Morgan Wallen performing One Thing At A Time (One Records At A Time Sessions)\n                                </p>\n                                <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-number\" mbr-if=\"showCardNumber\">\n                                    <b>3.1M</b>\n                                </p>\n                                <p class=\"card-text-small mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text-small\" mbr-if=\"showCardTextSmall\">\n                                    VIEWS\n                                </p>\n                                <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white-outline\" href=\"https://youtu.be/S-OKqDu8YmA\" data-app-placeholder=\"Type Text\" target=\"_blank\">\n                                        <span class=\"mobi-mbri mobi-mbri-play mbr-iconfont mbr-iconfont-btn\"></span>\n                                        WATCH\n                                    </a></div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardCount > 3\">\n                        <div class=\"card-wrap\">\n                            <div class=\"card-img-box\">\n                                <img src=\"@PROJECT_PATH@/assets/images/wwwwww-1280x720.jpg\" alt=\"workout\">\n                            </div>\n                            <div class=\"card-bg-frame\" mbr-if=\"showCardImg\"></div>\n                            <div class=\"card-text-box\">\n                                <h3 class=\"card-title mbr-fonts-style mb-0\" data-app-selector=\".card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\"><b>Make Your Workout Worth the Effort with Optimum Nutrition</b></h3>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text, .mbr-section-btn\" mbr-if=\"showCardText\">\n                                    Recover with the World's Best Selling Whey Protein Powder.\n                                </p>\n                                <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-number\" mbr-if=\"showCardNumber\">\n                                    <b>3.1M</b>\n                                </p>\n                                <p class=\"card-text-small mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text-small\" mbr-if=\"showCardTextSmall\">\n                                    VIEWS\n                                </p>\n                                <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white-outline\" href=\"https://youtu.be/99LquYW0LAg\" data-app-placeholder=\"Type Text\" target=\"_blank\">\n                                        <span class=\"mobi-mbri mobi-mbri-play mbr-iconfont mbr-iconfont-btn\"></span>\n                                        WATCH\n                                    </a></div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardCount > 4\">\n                        <div class=\"card-wrap\">\n                            <div class=\"card-img-box\">\n                                <img src=\"@PROJECT_PATH@/assets/images/galaxy-1280x720.jpg\" alt=\"Galaxy \">\n                            </div>\n                            <div class=\"card-bg-frame\" mbr-if=\"showCardImg\"></div>\n                            <div class=\"card-text-box\">\n                                <h3 class=\"card-title mbr-fonts-style mb-0\" data-app-selector=\".card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\"><b>Galaxy S23 Ultra: Official Introduction Film | Samsung</b></h3>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text, .mbr-section-btn\" mbr-if=\"showCardText\">\n                                    What’s new? The new Galaxy S23 Ultra. Share the epic with our most powerful processor yet, a pro-grade camera that boasts epic Nightography, and the mighty embedded S Pen\n                                </p>\n                                <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-number\" mbr-if=\"showCardNumber\">\n                                    <b>6.3M</b>\n                                </p>\n                                <p class=\"card-text-small mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text-small\" mbr-if=\"showCardTextSmall\">\n                                    VIEWS\n                                </p>\n                                <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white-outline\" href=\"https://youtu.be/BSYsXVFzmKA\" data-app-placeholder=\"Type Text\" target=\"_blank\">\n                                        <span class=\"mobi-mbri mobi-mbri-play mbr-iconfont mbr-iconfont-btn\"></span>\n                                        WATCH\n                                    </a></div>\n                            </div>\n                        </div>\n                    </div>\n\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
