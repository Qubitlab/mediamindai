          "_name": "afeatures5",
          "_sourceTheme": "mediam5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features5 mediam5 mbr-fullscreen\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"5\" step=\"1\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\">Left</option>\n            <option value=\"justify-content-center\" selected>Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"image\" title=\"Content Bg Image\" name=\"contentBgImg\" value=\"@PROJECT_PATH@/assets/images/4311.jpg\">\n        <input type=\"range\" inline title=\"Opacity Bg Image\" name=\"OpacityBgImg\" min=\"0\" max=\"1\" step=\"0.01\" value=\"0.3\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n            <input type=\"color\" title=\"Color\" value=\"#181817\" selected>\n        </fieldset>\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n    <div class=\"container\">\n        <div class=\"img-bg-container\">\n            <div class=\"img-bg\"></div>\n            <div class=\"row {{contentAlign}}\">\n                <div class=\"col-12 col-md-8 col-lg-7 col-xl-{{textWidth}} col-text\">\n                    <div class=\"text-wrap\">\n                        <h1 class=\"mbr-section-title mbr-fonts-style align-center\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-section-title , .mbr-section-btn\" mbr-if=\"showTitle\"><b>CREATING VIDEO MARKETING CONTENT FOR SOCIAL MEDIA</b></h1>\n                        <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn align-center\" mbr-if=\"showButtons\"><a class=\"btn btn-white-outline\" href=\"index.html\" data-app-placeholder=\"Type Text\">\n                                READ MORE\n                            </a></div>\n                        <p class=\"mbr-text mbr-fonts-style align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n                            Creating video marketing content for social media involves strategically planning, producing, and distributing videos that resonate with the target audience, align with platform-specific requirements, optimize for mobile viewing, convey compelling messages, evoke emotions, and drive desired actions, ultimately maximizing brand visibility, engagement, and conversions in the dynamic landscape of social media.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
